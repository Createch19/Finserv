/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model. Admins have broad access,
 * while agents are restricted to creating and managing customer records.  All authenticated
 * users can read customer data.  Listing all users is explicitly denied.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information (role, email, name).
 * - /customers/{customerId}: Stores customer loan information. Includes denormalized `agentId` to track ownership.
 *
 * Key Security Decisions:
 * - User listing is denied to prevent information leakage.
 * - Customer data is readable by all authenticated users.
 * - Agents can only create customers and can only modify customers they created.
 *
 * Denormalization for Authorization:
 * - The `customers` documents store the `agentId` of the user who created them, enabling owner-based access control for updates and deletes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, list, update, delete) Only the user with matching UID can access their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted.

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to customer data.
     * @path /customers/{customerId}
     * @allow (get, list) All authenticated users can read customer data.
     * @allow (create) Agents can create customer records and must set agentId to their own UID.
     * @allow (update, delete) Only the agent who created the customer can modify or delete the record.
     * @deny (create) Non-agents cannot create customer records.
     * @deny (update, delete) Agents cannot modify or delete customer records they did not create.
     * @principle Allows public read access while restricting write access to authorized agents.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.agentId == resource.data.agentId;
      allow delete: if isSignedIn() && request.resource.data.agentId == resource.data.agentId;
    }
  }
}
/**
 * @fileOverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control, with admins having full access and agents having limited access to customer data.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer information, including the assigned agent.
 *
 * Key Security Decisions:
 * - Admins have full read and write access to all customer data.
 * - Agents can only create, read, update and delete customer data where the agent field matches their own user ID.
 * - Customers collection is not listable to the public.
 *
 * Denormalization for Authorization:
 * - Each customer document includes an 'agent' field containing the agent's UID.
 *   This avoids the need for complex queries to determine agent assignment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the 'customers' collection.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (create) Agent can create a new customer assigned to themselves.
     *   - Request: { auth.uid: 'agent123' }, New Customer Data: { agent.uid: 'agent123' }
     * @allow (get) Agent can read a customer assigned to themselves.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent123' }
     * @allow (update) Agent can update a customer assigned to themselves.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent123' }, Updated Customer Data: { agent.uid: 'agent123' }
     * @allow (delete) Agent can delete a customer assigned to themselves.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent123' }
     * @deny (create) Agent attempts to create a new customer assigned to another agent.
     *   - Request: { auth.uid: 'agent123' }, New Customer Data: { agent.uid: 'agent456' }
     * @deny (get) Agent attempts to read a customer assigned to another agent.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent456' }
     * @deny (update) Agent attempts to update a customer assigned to another agent.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent456' }, Updated Customer Data: { agent.uid: 'agent456' }
     * @deny (delete) Agent attempts to delete a customer assigned to another agent.
     *   - Request: { auth.uid: 'agent123' }, Existing Customer Data: { agent.uid: 'agent456' }
     * @principle Enforces agent-ownership for customer data. Admins have full access.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn() && (isAdmin() || isAgentOfCustomer());
      allow list: if false;
      allow create: if isSignedIn() && (isAdmin() || isCreatingAgentOwnedCustomer());
      allow update: if isSignedIn() && (isAdmin() || isExistingAgentOfCustomer());
      allow delete: if isSignedIn() && (isAdmin() || isExistingAgentOfCustomer());
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user has the 'admin' role.
     * @returns {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    /**
     * @description Checks if the authenticated user is the agent assigned to a specific customer.
     * @param {string} customerId The ID of the customer document.
     * @returns {boolean} True if the user is the assigned agent, false otherwise.
     */
    function isAgentOfCustomer() {
      return resource.data.agent == request.auth.uid;
    }

    /**
     * @description Checks if the authenticated user is creating a new customer document assigned to themselves.
     * @param {string} customerId The ID of the customer document.
     * @returns {boolean} True if the user is creating the document and assigning it to themselves, false otherwise.
     */
    function isCreatingAgentOwnedCustomer() {
        return request.resource.data.agent == request.auth.uid && request.auth.token.role == 'agent';
    }

    /**
     * @description Checks if the authenticated user is the existing agent assigned to a specific customer and the resource exists.
     * @param {string} customerId The ID of the customer document.
     * @returns {boolean} True if the user is the assigned agent and the resource exists, false otherwise.
     */
    function isExistingAgentOfCustomer() {
      return resource.data.agent == request.auth.uid && request.auth.token.role == 'agent';
    }
  }
}
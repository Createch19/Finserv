/**
 * @fileOverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with specific rules for admins and agents.
 * Admins have full access to all customer data, while agents have access only to customer data where they are assigned as the agent.
 *
 * Data Structure:
 * The primary data is stored in the `/customers` collection.
 * Customer documents contain embedded data for payments and agents.
 *
 * Key Security Decisions:
 * - Users can only read their own user document.
 * - Admins have full access to all customer data.
 * - Agents have access only to customer documents where they are assigned as the agent.
 * - Denormalization is used to store the agent's UID within the customer document for efficient access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the customer's agent UID.
     * @param {string} agentUid - The agent UID to compare against the authenticated user's UID.
     */
    function isAgent(agentUid) {
      return isSignedIn() && request.auth.uid == agentUid;
    }

    /**
     * @description Checks if the authenticated user is an admin based on the user document.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * @description Checks if the customer document exists and the authenticated user is the agent.
     * @param {string} agentUid - The agent UID to compare against the authenticated user's UID.
     */
    function isExistingAgent(agentUid) {
      return isAgent(agentUid) && resource != null;
    }

    /**
     * @description
     * @path /users/{userId}
     * @allow (get) User with UID 'user123' can read their own document.
     * @deny (get) User with UID 'user456' cannot read document of 'user123'.
     * @principle Enforces document ownership for reads.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      /**
       * @description
       * @path /users/{userId}
       * @allow (create) User with UID 'user123' can create their own user document.
       * @deny (create) User with UID 'user456' cannot create document for 'user123'.
       * @principle Enforces document ownership for writes and validates data consistency.
       */
      allow create: if isOwner(userId);

      /**
       * @description
       * @path /users/{userId}
       * @allow (update) User with UID 'user123' can update their own user document.
       * @deny (update) User with UID 'user456' cannot update document of 'user123'.
       * @principle Enforces document ownership for writes and validates data consistency.
       */
      allow update: if isOwner(userId);

      /**
       * @description
       * @path /users/{userId}
       * @allow (delete) User with UID 'user123' can delete their own user document.
       * @deny (delete) User with UID 'user456' cannot delete document of 'user123'.
       * @principle Enforces document ownership for writes.
       */
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for the /customers collection.
     * @path /customers/{customerId}
     * @allow (get) Admin can read any customer document.
     * @allow (get) Agent can read a customer document if they are the assigned agent.
     * @deny (get) Agent cannot read a customer document if they are not the assigned agent.
     * @allow (list) Admin can list customer documents.
     * @deny (list) Non-Admin cannot list customer documents.
     * @principle Allows admins to read all customers. Allows agents to read their assigned customers.
     */
    match /customers/{customerId} {
        allow get: if isAdmin() || isAgent(resource.data.agent.uid);
        allow list: if isAdmin();

      /**
       * @description
       * @path /customers/{customerId}
       * @allow (create) Admin can create customer documents.
       * @allow (create) Agent can create customer documents, and the agent UID must match their own.
       * @deny (create) Agent cannot create customer documents with a different agent UID.
       * @principle Only admins and agents can create customer documents. The 'agentUid' field must match the authenticated user's UID.
       */
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.agent.uid == request.auth.uid);

      /**
       * @description
       * @path /customers/{customerId}
       * @allow (update) Admin can update any customer document.
       * @allow (update) Agent can update customer documents where they are the assigned agent.
       * @deny (update) Agent cannot update customer documents where they are not the assigned agent.
       * @principle Only admins and assigned agents can update customer documents.
       */
      allow update: if isAdmin() || isExistingAgent(resource.data.agent.uid);

      /**
       * @description
       * @path /customers/{customerId}
       * @allow (delete) Admin can delete any customer document.
       * @allow (delete) Agent can delete customer documents where they are the assigned agent.
       * @deny (delete) Agent cannot delete customer documents where they are not the assigned agent.
       * @principle Only admins and assigned agents can delete customer documents.
       */
      allow delete: if isAdmin() || isExistingAgent(resource.data.agent.uid);
    }
  }
}
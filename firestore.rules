/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the FINSERV application's Firestore database.
 *
 * Core Philosophy:
 * The security model enforces role-based access control. Admins have full access, while agents have read-only access to customer data. User data is private and only accessible to the owning user.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the authenticated user can access their own profile.
 * - /customers/{customerId}: Stores customer data. Publicly readable, but write access is restricted based on user roles.
 *
 * Key Security Decisions:
 * - Users can only access their own user documents.
 * - All authenticated users can list customer data.
 * - Data validation is minimized in this prototyping phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner.
     * @param {string} userId - The user ID to compare against.
     * @return {bool} True if the user is the owner, and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines rules for user documents.
     * @path /users/{userId}
     * @allow (create) - User 'alice' (UID: 'alice-uid') can create her own user document with matching UID.
     * @allow (get, update, delete) - User 'alice' (UID: 'alice-uid') can get, update, and delete her own user document.
     * @deny (create) - User 'bob' (UID: 'bob-uid') cannot create a user document with ID 'alice-uid'.
     * @deny (get, update, delete) - User 'bob' (UID: 'bob-uid') cannot get, update, or delete user document 'alice-uid'.
     * @principle Enforces document ownership for user data.
     */
    match /users/{userId} {
      // Only the authenticated user can read their own document.
      allow get: if isOwner(userId);
      allow list: if false;

      // Allow the user to create their own document, but enforce that the userId in the path matches the authenticated user's UID.
      allow create: if isOwner(userId);

      // Only the authenticated user can update their own document. Enforce immutability of the userId.
      allow update: if isExistingOwner(userId);

      // Only the authenticated user can delete their own document.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines rules for customer documents.
     * @path /customers/{customerId}
     * @allow (get, list) - Any authenticated user can read customer data.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete customer data.
     * @principle Allows public read access to customer data but restricts write access to admins.
     */
    match /customers/{customerId} {
      // Anyone can read customer data.
      allow get, list: if isSignedIn();

      // No one can create, update, or delete customer data.
      allow create, update, delete: if false;
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with distinctions between 'admin' and 'agent' roles.
 * Admins have full read and write access to all data, while agents have more restricted access, primarily to customers they manage.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, including role (admin or agent).
 * - /customers/{customerId}: Stores customer data, including the assigned agent's UID.
 *
 * Key Security Decisions:
 * - Users collection is not listable.
 * - Agents are restricted to only creating, updating, and deleting customers assigned to them.
 * - The `agent` field is denormalized within the `Customer` documents to simplify agent-specific authorization checks.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity includes an `agent` sub-object, containing the agent's UID. This allows direct authorization checks on customer documents based on the agent's identity, avoiding the need for separate lookups or complex queries.
 *
 * Structural Segregation:
 * - The data is split between `/users` (user profiles) and `/customers` (customer data), allowing for different access control policies on each.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the /users collection. Only admins can read user profiles. Users are not listable.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get) User with admin role can read any user document.
     * @deny (get) User with agent role cannot read any user document.
     * @allow (create) A user can create their own profile if the UID matches.
     * @allow (update) A user can update their own profile if the UID matches. Admin can update any profile.
     * @allow (delete) Only admin can delete a user profile.
     * @principle Enforces role-based access control and user ownership for profile management.
     */
    match /users/{userId} {
      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isAgent() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isSignedIn() {
          return request.auth != null;
      }

      allow get: if isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isOwner(userId) && request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Secure the /customers collection. Admins have full access. Agents can only create customers and read them.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get) Admins can read any customer document.
     * @allow (get) Agents can read a customer document if the agent's UID matches the customer's agent.uid.
     * @allow (create) Agents can create customer documents, with the agent.uid matching their own UID.
     * @deny (update) Agents cannot update customer documents after creation. Only Admins can.
     * @deny (delete) Agents cannot delete customer documents. Only Admins can.
     * @principle Enforces role-based access control with agent-specific ownership for customer data.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isAgent() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }

      function isAgentForCustomer() {
        return isSignedIn() && isAgent() && resource.data.agent.uid == request.auth.uid;
      }

      function isNewAgentForCustomer() {
        return isSignedIn() && isAgent() && request.resource.data.agent.uid == request.auth.uid;
      }

      function isSignedIn() {
        return request.auth != null;
      }


      allow get: if isAdmin() || isAgentForCustomer();
      allow list: if isAdmin(); // Agents cannot list all customers.
      allow create: if isNewAgentForCustomer();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
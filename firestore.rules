/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control (RBAC) with 'admin' and 'agent' roles.
 * Admins have full access, while agents have more limited, self-scoped access.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer data.
 *
 * Key Security Decisions:
 * - Admin role has full CRUD access to all collections.
 * - Agents can create customers and manage customers assigned to them.
 * - Denormalization is used for authorization. Customer documents embed the agent's UID to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user has the admin role.
     * @returns {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * @description Checks if the current user has the agent role.
     * @returns {boolean} True if the user is an agent, false otherwise.
     */
    function isAgent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    /**
     * @description Checks if the current user is the agent associated with the customer.
     * @param {string} agentUid The UID of the agent.
     * @returns {boolean} True if the user is the associated agent, false otherwise.
     */
    function isCustomerAgent(agentUid) {
      return isAgent() && request.auth.uid == agentUid;
    }

    /**
     * @description Checks if the customer document exists and the current user is the associated agent.
     * @param {string} agentUid The UID of the agent.
     * @returns {boolean} True if the document exists and the user is the associated agent, false otherwise.
     */
    function isExistingCustomerAgent(agentUid) {
      return resource != null && isCustomerAgent(agentUid);
    }

    /**
     * @description Rules for the 'customers' collection.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (create) - An admin can create any customer. An agent can create a customer and assign themselves as the agent.
     * @allow (get, list) - Anyone can read customer data.
     * @allow (update, delete) - An admin can update/delete any customer. An agent can update/delete customers assigned to them.
     * @deny (create) - An agent attempts to create a customer without assigning themselves as the agent.
     * @principle Enforces role-based access control for customer data management.
     */
    match /customers/{customerId} {
      allow get, list: if true;

      allow create: if isAdmin() || (isAgent() && request.resource.data.agent.uid == request.auth.uid);
      allow update, delete: if isAdmin() || isExistingCustomerAgent(resource.data.agent.uid);
    }
  }
}
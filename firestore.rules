/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with strict separation
 * of privileges between 'admin' and 'agent' users.  Data ownership is also enforced,
 * where applicable. The rules are designed to prevent unauthorized data access
 * and modification, especially regarding customer information.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles (admins and agents).
 * - /customers/{customerId}: Stores customer records, with agent assignment embedded.
 *
 * Key Security Decisions:
 * - Admins have read access to all customers.
 * - Agents can only create new customers.
 * - Agents CANNOT access the customer details screen.
 * - User listing is disallowed to prevent information harvesting.
 *
 * Denormalization for Authorization:
 * - Customer documents embed the Agent's UID, name and email
 *   to allow direct authorization checks without needing to query the /users collection.
 *
 * Structural Segregation:
 * - There is no structural segregation in this version.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the /users collection, allowing users to read their own profile data and restricting modifications.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, list) User with matching UID can read their profile.
     * @allow (create) User can create their own profile if the UID matches.
     * @deny (update, delete) User cannot update or delete their profile.
     * @principle Enforces document ownership and prevents unauthorized profile changes.
     */
    match /users/{userId} {
      //function isSignedIn() {
      //  return request.auth != null;
      //}

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures the /customers collection, restricting access based on user roles and agent assignment.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get, list) Admins can read all customers.
     * @allow (create) Agents can create new customers.
     * @deny (update, delete, get) Agents cannot update, delete, or get existing customers.
     * @deny (get) Non-admin users cannot access customer details screen.
     * @principle Enforces role-based access control and prevents unauthorized modification of customer data.
     */
    match /customers/{customerId} {

      function isAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isAgent() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }

      // Admins can get customer information
      allow get: if false; //Admin can not navigate to customer details screen

      // Admins can list customer information
      allow list: if isAdmin();

      // Agents can create customers
      allow create: if isAgent();

      // Agents cannot update or delete customer information.
      allow update: if false;
      allow delete: if false;
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, where 'admins' have broad access and 'agents' have limited, ownership-based access to customer data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /customers/{customerId}: Stores customer data. Access is restricted based on the user's role and ownership.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data in /users/{userId}.
 * - Admins are explicitly denied direct access to Customer data to address requirement that "admin cannot able to see the customer data while navigating to customer detais screen."
 * - Agents can create customer profiles and can only update/delete customer profiles they own (where they are the assigned agent).
 * - Listing of all users is disallowed for security.
 *
 * Denormalization for Authorization:
 * - Customer documents contain an embedded "agent" object with the agent's UID. This allows for efficient ownership checks on the customer documents without requiring additional reads.
 *
 * Structural Segregation:
 * - Customer data is stored in a single top-level collection to simplify querying and management. Access control is enforced through security rules based on the user's role and ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is signed in and the requested userId matches their own UID.
     * @deny (get, create, update, delete) if the user is not signed in or the userId does not match their own UID.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows agents to create customer profiles and manage those they own, but disallows admins to see customer data.
     * @path /customers/{customerId}
     * @allow (create) if the user is an agent and the agent.uid matches the request.auth.uid.
     * @allow (get, list) if the user is an agent and the agent.uid matches the request.auth.uid.
     * @allow (update, delete) if the user is an agent, the agent.uid matches the request.auth.uid, and the customerId exists.
     * @deny (create, get, list, update, delete) if the user is not an agent, the agent.uid does not match the request.auth.uid, or the customerId does not exist.
     * @principle Enforces agent-ownership for customer data, denying admin access.
     */
    match /customers/{customerId} {
      function isAgent() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }
      function isCustomerAgent(agentUid) {
          return request.auth.uid == agentUid;
      }
      function isExistingCustomerAgent(agentUid) {
          return isCustomerAgent(agentUid) && resource != null;
      }

      allow get: if isAgent() && isCustomerAgent(resource.data.agent.uid);
      allow list: if isAgent() && isCustomerAgent(resource.data.agent.uid);
      allow create: if isAgent() && isCustomerAgent(request.resource.data.agent.uid);
      allow update: if isAgent() && isExistingCustomerAgent(resource.data.agent.uid);
      allow delete: if isAgent() && isExistingCustomerAgent(resource.data.agent.uid);
    }
  }
}
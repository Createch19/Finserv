/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model where agents can only access and manage data related to their assigned customers.
 * Administrative privileges are not yet implemented in this ruleset.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. 'userId' corresponds to the Firebase Authentication UID.
 * - /users/{userId}/customers/{customerId}: Stores customer data, linked to a specific agent. 'userId' here represents the agent's ID.
 * - /users/{userId}/customers/{customerId}/payments/{paymentId}: Stores payment information for a customer, nested under the customer document.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.  Listing all users is disallowed.
 * - Agents can only manage customers and payments associated with their user ID.
 * - No public data access is permitted.
 *
 * Denormalization for Authorization:
 * - The 'Customer' entity includes 'agentId', mirroring the 'userId' from the parent path. This denormalization allows rules to validate customer ownership without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.  Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the request is made by the user with matching userId.
     * @deny (get, create, update, delete) if the request is made by a different user.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to customer data. Agents can only manage customers assigned to them.
     * @path /users/{userId}/customers/{customerId}
     * @allow (get, create, update, delete) if the request is made by the agent with matching userId and agentId on customer data matches that userId.
     * @deny (get, create, update, delete) if the request is made by a different agent or the agentId does not match the userId.
     * @principle Enforces agent-ownership for customer data.
     */
    match /users/{userId}/customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.agentId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.agentId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to payment data. Agents can only manage payments for customers assigned to them.
     * @path /users/{userId}/customers/{customerId}/payments/{paymentId}
     * @allow (get, create, update, delete) if the request is made by the agent with matching userId.
     * @deny (get, create, update, delete) if the request is made by a different agent.
     * @principle Enforces agent-ownership for customer payment data.
     */
    match /users/{userId}/customers/{customerId}/payments/{paymentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}
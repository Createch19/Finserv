/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with specific rules governing access to user profiles and customer data.
 * Admins have full access, while agents have restricted access to customer data they create.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /customers/{customerId}: Stores customer data, including personal details, loan information, and agent assignment.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Admins have full access to all customer data.
 * - Agents can only create customer data and only read and modify customer data assigned to them.
 * - Listing users is disallowed to prevent unauthorized enumeration of user accounts.
 *
 * Denormalization for Authorization:
 * - Customer documents include an embedded "agent" object containing the agent's UID. This enables rules to efficiently check agent assignments without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Users can only read and write their own profile data. Listing users is disallowed.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get) User with UID 'user_abc' can read their own profile.
     * @allow (create) User with UID 'user_abc' can create their profile if request.auth.uid == 'user_abc'.
     * @allow (update) User with UID 'user_abc' can update their own profile.
     * @allow (delete) User with UID 'user_abc' can delete their own profile.
     * @deny (get) User with UID 'user_xyz' cannot read the profile of user 'user_abc'.
     * @deny (create) User with UID 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @deny (update) User with UID 'user_xyz' cannot update the profile of user 'user_abc'.
     * @deny (delete) User with UID 'user_xyz' cannot delete the profile of user 'user_abc'.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to customer data. Admins have full access. Agents can only access customers they are assigned to.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get) Admin can read any customer data.
     * @allow (get) Agent can read customer data assigned to them.
     * @allow (create) Admin can create customer data.
     * @allow (create) Agent can create customer data and is assigned to them.
     * @allow (update) Admin can update any customer data.
     * @allow (update) Agent can update customer data assigned to them.
     * @allow (delete) Admin can delete any customer data.
     * @allow (delete) Agent can delete customer data assigned to them.
     * @deny (get) Agent cannot read customer data not assigned to them.
     * @deny (create) Agent cannot create customer data not assigned to them.
     * @deny (update) Agent cannot update customer data not assigned to them.
     * @deny (delete) Agent cannot delete customer data not assigned to them.
     * @principle Enforces role-based access control for customer data.
     */
    match /customers/{customerId} {
        function isAdmin() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
        function isAgent() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
        }
        allow get: if isAdmin() || (isAgent() && resource.data.agent.uid == request.auth.uid);
        allow list: if false;
        allow create: if isAdmin() || (isAgent() && request.resource.data.agent.uid == request.auth.uid);
        allow update: if isAdmin() || (isAgent() && resource.data.agent.uid == request.auth.uid);
        allow delete: if isAdmin() || (isAgent() && resource.data.agent.uid == request.auth.uid);
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with strict ownership for customer data. Admins have full access, while agents are limited to customers they manage.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /customers/{customerId}: Stores customer data, with access controlled by user role and agent assignment.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Strict ownership is enforced for agents and their assigned customers.
 * - Read-only collections are not used in this data model.
 *
 * Denormalization for Authorization:
 * The `Customer` entity includes an `agent` sub-object containing the agent's `uid`. This denormalization enables efficient security rules that avoid costly `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User can access and modify their own profile.
     * @deny (list) User listing is not allowed.
     * @deny (create, update, delete) Users cannot create, update or delete other user profiles.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId);
      }

      allow get, update, delete: if isExistingOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Manages access to customer data.
     * @path /customers/{customerId}
     * @allow (get, list) Admins can read any customer data. Agents can read customer data where they are the assigned agent.
     * @allow (create) Admins can create any customer. Agents can create customers, and their UID is stored in the customer document.
     * @allow (update, delete) Admins can update or delete any customer data. Agents can only update or delete customer data where they are the assigned agent.
     * @deny (create, update, delete) Agents cannot create, update or delete customers assigned to other agents.
     * @principle Enforces role-based access control and agent ownership for customer data.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      function isAgent() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }
      function isOwner(agentUid) {
          return request.auth.uid == agentUid;
      }
      function isExistingOwner(agentUid) {
        return isOwner(agentUid);
      }

      allow get, list: if isAdmin() || (isAgent() && resource.data.agent.uid == request.auth.uid);
      allow create: if isAdmin() || (isAgent() && request.resource.data.agent.uid == request.auth.uid);
      allow update, delete: if isAdmin() || (isAgent() && resource.data.agent.uid == request.auth.uid);
    }
  }
}
/**
 * @fileOverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user roles and authenticated sessions.
 * It allows for a flexible data schema during the prototyping phase but strictly enforces authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, secured to owner-only access.
 * - /customers/{customerId}: Stores customer data. Accessible to all authenticated users.
 *
 * Key Security Decisions:
 * - User listing is disabled for security reasons.
 * - All write operations are protected by authorization checks, preventing unauthorized data modification.
 * - Read access to customer data is public to all authenticated users.
 *
 * Denormalization for Authorization:
 * N/A in the current schema.
 *
 * Structural Segregation:
 * N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profile data.
     * @path /users/{userId}
     * @allow (create) User 'user_abc' can create their own profile.
     * @deny (create) User 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @allow (get, list) User 'user_abc' can read their own profile.
     * @deny (get, list) User 'user_xyz' cannot read profile 'user_abc'.
     * @allow (update, delete) User 'user_abc' can update/delete their own profile.
     * @deny (update, delete) User 'user_xyz' cannot update/delete profile 'user_abc'.
     * @principle Enforces strict user-ownership for profile data.
     */
    match /users/{userId} {
      // Validate that the authenticated user's ID matches the userId in the path
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.email == request.auth.token.email;
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.email == resource.data.email;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to read customer data, but restricts writes.
     * @path /customers/{customerId}
     * @allow (get, list) Any authenticated user can read customer data.
     * @deny (create, update, delete) Non-owners cannot modify customer data.
     * @principle Public read access for authenticated users, owner-only writes.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ----- Helper functions -----

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user ID matches the authenticated user's ID and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
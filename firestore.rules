rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow only authenticated users
    allow read, write: if request.auth != null;

    // Secure the /customers collection
    match /customers/{customerId} {
      // Allow agents to create customers if the agent field matches their UID
      allow create: if request.auth.uid == request.resource.data.agent.uid;

      // Allow agents to read, update, and delete customers if the agent field matches their UID
      allow read, update, delete: if request.auth.uid == resource.data.agent.uid;

      // Prevent agents from modifying the agent field after customer creation
      allow update: if request.auth.uid == resource.data.agent.uid
                      && request.resource.data.agent.uid == resource.data.agent.uid;
    }

    // Secure the /users collection from listing
    match /users/{userId} {
      allow get, create, update, delete: if false;
      allow list: if false;
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, where 'admin' users have full access and 'agent' users have limited access to customer data.
 * All operations require authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, including role (admin/agent).
 * - /customers/{customerId}: Stores customer data, including an 'agent' sub-document containing the agent's UID.
 *
 * Key Security Decisions:
 * - Users can only create their own user document.
 * - Admins have full CRUD access to customer data.
 * - Agents can only create customers and list all customers but cannot update or delete customer data.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity includes an embedded `Agent` object containing the agent's UID,
 *   enabling direct authorization checks without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to create their own user document. Admins can read all user documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creating their own document.
     *     Request: auth.uid = "user123", documentId = "user123"
     * @allow (get, list) - Admin user reading user data.
     *     Request: auth.uid = "admin123", user role = "admin"
     * @deny (create) - Authenticated user trying to create another user's document.
     *     Request: auth.uid = "user123", documentId = "user456"
     * @deny (update, delete) - Only admins can update or delete user documents
     * @principle Enforces user-ownership for creation, admin-only for update/delete.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }

    /**
     * @description Allows admins to create, read, update, and delete customer documents.
     *              Allows agents to create customer documents they own.
     * @path /customers/{customerId}
     * @allow (create) - Admin or agent creating a new customer document. The agent's uid must match the request auth UID.
     *     Request: auth.uid = "agent123", document.data.agent.uid = "agent123"
     * @allow (get, list) - Admin user listing all customer documents.
     *     Request: auth.uid = "admin123", user role = "admin"
     * @deny (create) - Agent attempting to create customer with mismatched agent ID.
     *     Request: auth.uid = "agent123", document.data.agent.uid = "agent456"
     * @deny (update, delete) - Agents are not allowed to update or delete customers.
     *     Request: auth.uid = "agent123", operation = "update"
     * @principle Enforces role-based access control for customer data, with ownership for creation.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.agent.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource (userId matches auth.uid).
     * @param {string} userId - The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}
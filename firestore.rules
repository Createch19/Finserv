/**
 * @file Firestore Security Rules
 * @description This ruleset enforces role-based access control for the FINSERV application.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer loan and payment information. Each customer document includes an embedded agent object.
 *
 * Key Security Decisions:
 * - Admins have full access to all customer data.
 * - Agents can only create, read, update, and delete customers assigned to them (where the `agent.uid` field matches their own UID).
 * - Customer listing is restricted to admins only. Agents cannot list all customers.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity embeds the `Agent` entity directly within its document. This denormalization is crucial for enforcing agent-specific access control without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to the 'customers' collection.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (create) - An agent can create a customer with their own agent.uid.
     * @allow (get) - An admin can get any customer, or an agent can get a customer assigned to them.
     * @allow (update) - An admin can update any customer, or an agent can update a customer assigned to them.
     * @allow (delete) - An admin can delete any customer, or an agent can delete a customer assigned to them.
     * @deny (list) - Agents cannot list all customers (only admins can).
     * @deny (create) - An agent cannot create a customer assigned to another agent.
     * @principle Enforces role-based access control and agent ownership for customer data.
     */
    match /customers/{customerId} {
      // Helper function to check if the user is an admin
      function isAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      // Helper function to check if the user is the assigned agent for a customer
      function isAgentOfCustomer(agentUid) {
        return request.auth.uid == agentUid;
      }

      // Helper function to check if the user is the existing assigned agent for a customer for update and delete operations
      function isExistingAgentOfCustomer(agentUid) {
        return resource != null && request.auth.uid == agentUid;
      }

      // Read rules
      allow get: if isAdmin() || isAgentOfCustomer(resource.data.agent.uid);
      allow list: if isAdmin(); // Only admins can list all customers
      
      // Write rules
      allow create: if isSignedIn() && isAgentOfCustomer(request.resource.data.agent.uid);
      allow update: if isAdmin() || isExistingAgentOfCustomer(resource.data.agent.uid);
      allow delete: if isAdmin() || isExistingAgentOfCustomer(resource.data.agent.uid);
    }
    
    // Define isSignedIn function
    function isSignedIn() {
        return request.auth != null;
    }
  }
}
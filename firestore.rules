/**
 * @file Firestore Security Rules
 * @description This ruleset enforces role-based access control for the FINSERV application.
 *
 * Core Philosophy:
 * The security model is based on a role-based access control. Agents have access to all customer data, regardless of who created the customer record.
 *
 * Data Structure:
 * The primary data is stored in the `/customers` collection.  Each customer document contains customer details and information about assigned agent.
 *
 * Key Security Decisions:
 * - Agents can read, write, and delete all customer documents.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows agents to create, read, update, and delete customer documents.
     * @path /customers/{customerId}
     * @allow (read, write, delete) An agent can read, write, or delete any customer document.
     * @deny (none) No requests are denied based on the provided requirements.
     * @principle Grants full access to all agents for customer data management.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }


    // Define helper functions
    function isSignedIn() {
      return request.auth != null;
    }
  }
}
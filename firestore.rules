/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure access control based on user roles and ownership. It enforces
 * that users can only create their own user document, and admins have broader access to users and customers.
 * Agents are limited to viewing and managing customers they are assigned to.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /customers/{customerId}: Stores customer data, including agent assignment.
 *
 * Key Security Decisions:
 * - Users can list all user documents, but can only create their own.
 * - Admin users are implicitly trusted to manage all data (not yet implemented).
 * - Customer documents store agent assignment information directly within the document
 *   to avoid complex queries and ensure efficient security rules.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity includes the `agent` object.  This denormalization allows
 *   security rules to quickly determine if the currently logged-in agent is assigned to a specific customer.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /users/{userId} collection.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) - Authenticated user creates their own user document.
     * @allow (get, list) - Any authenticated user can get and list all user documents.
     * @deny (update, delete) - Non-admin users cannot update or delete user documents.
     * @principle Enforces user ownership for creation, but allows open reads to all users.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update, delete: if false;
    }

    /**
     * @description Controls access to the /customers/{customerId} collection.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get, list) - Any authenticated user can retrieve and list all customer documents.
     * @allow (create) - Allows an agent to create customer documents.
     * @deny (update, delete) - Only the assigned agent can update or delete the customer document.
     * @principle Enforces agent-based ownership for customer data management.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() ;
      allow update, delete: if isSignedIn() && isExistingAgent(resource.data.agent.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingAgent(agentId) {
      return isSignedIn() && request.auth.uid == agentId && resource != null;
    }
  }
}
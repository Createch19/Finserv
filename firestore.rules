/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for the FINSERV application,
 *              where agents can only access data related to their assigned customers and
 *              administrators are not explicitly granted any special permissions in this initial
 *              prototyping phase.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Access is restricted to the user themselves.
 * - /users/{userId}/customers/{customerId}: Stores customer data owned by a specific agent.
 * - /users/{userId}/customers/{customerId}/payments/{paymentId}: Stores payment data for a customer, accessible only by the owning agent.
 *
 * Key Security Decisions:
 * - User listing is not allowed.
 * - The 'agentId' field is denormalized into the Customer document to enforce authorization independence,
 *   avoiding costly 'get()' calls in the security rules.
 * - The rules do not validate the data types or required fields of the documents beyond what is
 *   necessary for authorization. This allows for rapid prototyping and schema iteration.
 * - All write operations are strictly validated against the authenticated user's ID to prevent
 *   unauthorized data modification.
 * - Rules are structured to be auditable and maintainable, with complex logic abstracted into helper functions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) if the authenticated user's ID matches the {userId}.
     * @allow (create) if the authenticated user's ID matches the {userId} and they are creating their own profile.
     * @deny (get, update, delete) if the authenticated user's ID does not match the {userId}.
     * @deny (create) if the authenticated user's ID does not match the {userId}.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces agent-ownership for customer data. Only the agent who "owns" the customer can read, write, or delete the customer data.
     * @path /users/{userId}/customers/{customerId}
     * @allow (get, list, update, delete) if the authenticated user's ID matches the {userId} and they are the agent for the customer.
     * @allow (create) if the authenticated user's ID matches the {userId} and they are creating a customer for themselves.
     * @deny (get, list, update, delete) if the authenticated user's ID does not match the {userId} or they are not the agent for the customer.
     * @deny (create) if the authenticated user's ID does not match the {userId} or they are not creating a customer for themselves.
     * @principle Enforces document ownership for all operations. The 'agentId' field is denormalized to avoid using 'get()' calls.
     */
    match /users/{userId}/customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Validates that the agentId matches the path and that the document exists.
      function isValidAgent(userId) {
        return request.resource.data.agentId == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAgent(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces agent-ownership for payment data. Only the agent who "owns" the customer can read, write, or delete the payment data.
     * @path /users/{userId}/customers/{customerId}/payments/{paymentId}
     * @allow (get, list, update, delete) if the authenticated user's ID matches the {userId} and they are the agent for the customer.
     * @allow (create) if the authenticated user's ID matches the {userId} and they are creating a payment for the customer.
     * @deny (get, list, update, delete) if the authenticated user's ID does not match the {userId} or they are not the agent for the customer.
     * @deny (create) if the authenticated user's ID does not match the {userId} or they are not creating a payment for the customer.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/customers/{customerId}/payments/{paymentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}
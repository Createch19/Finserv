
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users can read and update their own user document.
    match /users/{userId} {
      allow read, update: if isAuthed() && request.auth.uid == userId;
      // Admins can read all user docs
      allow list: if isAdmin();
    }

    // Customer rules
    match /customers/{customerId} {
      // Admins can read any customer.
      // Agents can read customers they are assigned to.
      allow read: if isAdmin() || (isAuthed() && resource.data.agent.uid == request.auth.uid);
      
      // Admins can write to any customer.
      // Agents can create/update customers where they are the agent.
      allow write: if isAdmin() || (isAuthed() && request.resource.data.agent.uid == request.auth.uid);
      
      // Admins and Agents can list customers. The query on the client enforces who sees what.
      allow list: if isAuthed();
    }

    // Only admins can read or write expenses.
    match /expenses/{expenseId} {
        allow read, write, list: if isAdmin();
    }

    // Only admins can manage expense types.
    match /expenseTypes/{expenseTypeId} {
        allow read, write: if isAdmin();
    }
  }
}

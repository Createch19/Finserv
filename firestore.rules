/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the FINSERV application.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves (owner) and admins.
 * - /customers/{customerId}: Stores customer data, readable by all authenticated users, but writeable only by the agent who created the customer record.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Customer data is readable by all logged-in users, regardless of role.
 * - The 'agentId' field on Customer documents is used to enforce ownership for write operations (create, update, delete).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data. Only the user themselves and admins can access their own profile.
     * @path /users/{userId}
     * @allow (get) User 'Oj6wlYl66YgTGpM1YZtIAWy1CVl1' can read their own profile data.
     * @allow (create) User 'Oj6wlYl66YgTGpM1YZtIAWy1CVl1' can create their own profile data.
     * @allow (update) User 'Oj6wlYl66YgTGpM1YZtIAWy1CVl1' can update their own profile data.
     * @allow (delete) User 'Oj6wlYl66YgTGpM1YZtIAWy1CVl1' can delete their own profile data.
     * @deny (get) User 'randomId' cannot read another user's profile.
     * @deny (create) User 'randomId' cannot create a profile with a different userId.
     * @deny (update) User 'randomId' cannot update another user's profile.
     * @deny (delete) User 'randomId' cannot delete another user's profile.
     * @principle Enforces user-ownership for access to profile information.
     */
    match /users/{userId} {
      // Only signed-in users can attempt to access user data.
      allow get: if isSignedIn() && isOwner(userId);
      // Prevent listing of all users
      allow list: if false;
      // Allow the user to create their own document if the userId matches their auth.uid
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.email == request.auth.token.email;
      // Allow the user to update their own document if the userId matches their auth.uid
      allow update: if isSignedIn() && isOwner(userId) && resource.data.email == request.auth.token.email;
      // Allow the user to delete their own document if the userId matches their auth.uid and the document exists
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages customer data. All authenticated users can read customer data, but only the creating agent can modify it.
     * @path /customers/{customerId}
     * @allow (get) Any logged in user can get any customer data.
     * @allow (list) Any logged in user can list any customer data.
     * @allow (create) User creates customer with their user id.
     * @allow (update) User can update customer with their user id.
     * @allow (delete) User can delete customer with their user id.
     * @deny (create) A user cannot create a customer and assign it to another agent.
     * @deny (update) A user cannot update a customer assigned to another agent.
     * @deny (delete) A user cannot delete a customer assigned to another agent.
     * @principle Enforces that only the creating agent can modify customer data. Public read, owner-only write.
     */
    match /customers/{customerId} {
      // Allow all authenticated users to read customer data
      allow get, list: if isSignedIn();

      // Allow create, update, and delete if the user is the owner (agentId matches) and the document exists for update/delete
      allow create: if isSignedIn() && request.resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.agentId == request.auth.uid;
      allow delete: if isSignedIn() && resource != null && resource.data.agentId == request.auth.uid;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with specific rules governing access to user profiles and customer data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with 'userId' matching the Firebase Auth UID.
 * - /customers/{customerId}: Stores customer data, with 'customerId' as the document ID. Customer documents contain nested agent information.
 *
 * Key Security Decisions:
 * - Listing all users is denied to prevent unauthorized enumeration.
 * - Customer access is role-based: admins have full access, while agents can only manage customers they are assigned to.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity embeds the `Agent` information (UID, name, email) to avoid needing separate queries for agent details during authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /users collection.
     * @path /databases/{database}/documents/users
     * @allow (create) If the user's UID matches the userId, they can create their own profile.
     * @deny (list) Listing all users is not allowed.
     * @deny (get) Non-owners cannot get a user document.
     * @deny (update) Non-owners cannot update a user document.
     * @deny (delete) Non-owners cannot delete a user document.
     * @principle Enforces user-ownership for profile data and restricts listing all users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to the /customers collection.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get, list) Admins can read any customer data. Agents can read customer data where they are the assigned agent.
     * @allow (create) Admins can create customers. Agents can create customers and must set their own agent ID.
     * @allow (update, delete) Admins can update or delete any customer. Agents can only update or delete customers where they are the assigned agent.
     * @deny (create) Agents cannot create a customer without setting the agent id to their own id.
     * @principle Enforces role-based access control for customer data, with owner-only access for agents.
     */
    match /customers/{customerId} {
      allow get: if isAdmin() || (isSignedIn() && isAgentForCustomer(resource.data.agent.uid));
      allow list: if isAdmin() || (isSignedIn() && isAgentForCustomer(resource.data.agent.uid));
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.agent.uid == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && isAgentForCustomer(resource.data.agent.uid));
      allow delete: if isAdmin() || (isSignedIn() && isAgentForCustomer(resource.data.agent.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAgent() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    function isAgentForCustomer(agentId) {
      return isSignedIn() && request.auth.uid == agentId;
    }
  }
}
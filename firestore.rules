/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control (RBAC) for customer data.
 * Administrators have full access, while agents are restricted to accessing only their assigned customers.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer records with an embedded agent object containing the agent's UID.
 *
 * Key Security Decisions:
 * - Only authenticated users can access the database.
 * - Customer documents contain agent information inside the `agent` field.
 * - Agents can only create customers and should have access to their customers.
 * - Administrators can create, read, update, and delete any customer.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity denormalizes agent information (UID, name, email) directly into the customer document under the `agent` field. This allows for efficient access control based on agent assignment without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows administrators to manage all customers, and agents to manage their own customers.
     * @path /customers/{customerId}
     * @allow (create) - An admin user can create a new customer.
     * @allow (get) - An admin user can read any customer's details.
     * @allow (update) - An admin user can update any customer's details.
     * @allow (delete) - An admin user can delete any customer.
     * @allow (create) - An agent user can create a new customer assigned to themself.
     * @allow (get) - An agent can read a customer assigned to themself.
     * @allow (update) - An agent can update a customer assigned to themself.
     * @allow (delete) - An agent can delete a customer assigned to themself.
     * @deny (create) - An unauthenticated user cannot create a customer.
     * @deny (get) - An unauthenticated user cannot read a customer.
     * @deny (update) - An agent user cannot update a customer that is not assigned to themself.
     * @deny (delete) - An agent user cannot delete a customer that is not assigned to themself.
     * @principle Implements role-based access control and ownership for customer records.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && (isAdmin() || (isAgent() && request.resource.data.agent.uid == request.auth.uid));
      allow update: if isSignedIn() && (isAdmin() || (isAgent() && getExistingAgentCustomer(customerId)));
      allow delete: if isSignedIn() && (isAdmin() || (isAgent() && getExistingAgentCustomer(customerId)));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function getExistingAgentCustomer(customerId) {
      return get(/databases/$(database)/documents/customers/$(customerId)).data.agent.uid == request.auth.uid;
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model.
 * Users can only manage their own profile data.
 * Agents can create and manage customers.
 * Public Read with Owner-Only Writes is applied for customers.
 *
 * Data Structure:
 * /users/{userId}: Stores user profile information. Only the user themselves can modify this data.
 * /customers/{customerId}: Stores customer data.
 *
 * Key Security Decisions:
 * - Users can only read/write their own /users/{userId} document.
 * - All authenticated users can list customers, but ownership (agentId) is validated for create, update, and delete operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile.
     * @allow (get, update, delete) - Authenticated user accesses their own profile.
     * @deny (create) - User tries to create a profile with a different userId.
     * @deny (get, update, delete) - User tries to access another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to customer documents. All authenticated users can list customers, but ownership (agentId) is validated for create, update, and delete operations.
     * @path /customers/{customerId}
     * @allow (get, list) - Any authenticated user can read customer data.
     * @allow (create) - Agents can create new customers, with agentId matching their own UID.
     * @allow (update, delete) - Only the agent who created the customer can update or delete the customer record.
     * @deny (create) - User tries to create a customer with an agentId that doesn't match their own UID.
     * @deny (update, delete) - User tries to update or delete a customer record they don't own.
     * @principle Public Read with Owner-Only Writes.
     */
    match /customers/{customerId} {
      function isAgent() {
        return request.auth.token.role == 'agent';
      }

      function isCustomerOwner(agentId) {
        return request.auth.uid == agentId;
      }

      function isSignedIn() {
        return request.auth != null;
      }


      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.agentId == resource.data.agentId && resource.data.agentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.agentId == request.auth.uid;
    }
  }
}
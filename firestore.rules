/**
 * @file Firestore Security Rules for FINSERV Application
 * @version 2
 *
 * @Core Philosophy:
 * This ruleset enforces role-based access control, with admins having full access and agents having limited access to customer data.
 * User data is private and only accessible to the user themselves. Customer access is restricted based on the agent assigned to the customer.
 *
 * @Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only by the user themselves.
 * - /customers/{customerId}: Stores customer information, accessible by admins and the assigned agent.
 *
 * @Key Security Decisions:
 * - Users can only read and write their own data.
 * - Admins have full access to customer data.
 * - Agents can only access customer documents where they are the assigned agent.
 * - No public listing of users is allowed.
 *
 * @Denormalization for Authorization:
 * - Customer documents embed the assigned agent's UID to simplify agent-based access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to the /users collection.  Users can only read and write their own data.
     * @path: /databases/{database}/documents/users/{userId}
     * @allow: User with UID 'user123' (get, create, update, delete)
     * @deny: User with UID 'user456' attempting to access 'user123' data (get, create, update, delete)
     * @principle: Enforces user ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description: Controls access to the /customers collection. Admins have full access. Agents can only access customers assigned to them.
     * @path: /databases/{database}/documents/customers/{customerId}
     * @allow: Admin user (get, create, update, delete, list). Agent user assigned to the customer (get, update, delete). Any user (list).
     * @deny: Agent user NOT assigned to the customer (get, create, update, delete).
     * @principle: Enforces role-based access control and agent-customer relationship.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isAgentOfCustomer(agentUid) {
        return isSignedIn() && request.auth.uid == agentUid;
      }

      function isExistingAgentOfCustomer(customerId) {
        return exists(/databases/$(database)/documents/customers/$(customerId));
      }

      allow get: if isAdmin() || (isSignedIn() && resource.data.agentUid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.agentUid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.agentUid == request.auth.uid);
    }
  }
}
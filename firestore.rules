/**
 * @fileOverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with different permissions granted to 'admin' and 'agent' users.
 * User data is secured under the `/users/{userId}` path, enforcing ownership.
 * Customer data is stored in a top-level `/customers/{customerId}` collection, accessible to all authenticated users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with userId matching the authenticated user's UID.
 * - /customers/{customerId}: Stores customer data.
 *
 * Key Security Decisions:
 * - Listing of all users is denied to prevent information disclosure.
 * - All authenticated users can read the customer collection.
 * - Only authenticated users can create, update, and delete documents in the customer collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profile data, ensuring only the owner can read and write.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile (userId matches auth.uid).
     * @allow (get, update, delete) If the user is the owner of the profile (userId matches auth.uid).
     * @deny (create, update, delete) If the user is not signed in.
     * @deny (create, update, delete) If the user is not the owner of the profile.
     * @deny (list) Listing all users is not permitted.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.email == request.auth.token.email;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.email == request.auth.token.email;
    }

    /**
     * @description Allows any authenticated user to read customer data. Only authenticated users can create, update, and delete customer data.
     * @path /customers/{customerId}
     * @allow (get, list) Any authenticated user can read customer data.
     * @allow (create, update, delete) Only authenticated users can create, update, and delete customer data.
     * @deny (create, update, delete) If the user is not signed in.
     * @principle Allows public read access for customer data, while restricting writes to authenticated users.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}
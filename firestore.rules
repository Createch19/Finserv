/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with specific rules for admins and agents.
 * Admins have full access to all customer data, while agents are limited to accessing only the customer data they are assigned to.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer data, including loan information and the assigned agent's information.
 *
 * Key Security Decisions:
 * - Agents can only create customers, with the agent's UID automatically assigned during creation.
 * - Agents cannot update or delete customer documents after creation.
 * - Listing customer documents is only allowed for admins.
 *
 * Denormalization for Authorization:
 * - The `Customer` entity contains an `agent` object with the `uid` of the assigned agent.
 * This denormalization allows for efficient security rules without needing extra reads to verify agent assignment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants admins full access to customer data, while agents can only create customers assigned to them.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (create) User with agent role can create a new customer and their `agent.uid` matches their own UID.
     * @deny (create) User with agent role attempts to create a customer where `agent.uid` does not match their own UID.
     * @allow (get) User with admin role can retrieve any customer.
     * @deny (get) User with agent role attempts to retrieve a customer not assigned to them.
     * @deny (update) Any user attempts to update a customer.
     * @deny (delete) Any user attempts to delete a customer.
     * @allow (list) User with admin role can list all customers.
     * @deny (list) User with agent role attempts to list customers.
     * @principle Enforces role-based access control for customer data, with agent-ownership for creation.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isAgent() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }

      function isAssignedAgent(agentUid) {
        return request.auth.uid == agentUid;
      }

      // Read Permissions
      allow get: if isAdmin();
      allow list: if isAdmin();

      // Write Permissions
      allow create: if isAgent() && isAssignedAgent(request.resource.data.agent.uid);
      allow update: if false;
      allow delete: if false;
    }
  }
}
/**
 * @fileOverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control, with admins having full access and agents having restricted access to customer data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles (admins and agents).
 * - /customers/{customerId}: Stores customer information, including the assigned agent.
 *
 * Key Security Decisions:
 * - Admins can read and write all user and customer data.
 * - Agents can only create customers and read/write customers assigned to them.
 * - Users cannot be listed.
 *
 * Denormalization for Authorization:
 * - Each customer document contains an 'agent' field with the agent's UID. This is used to enforce agent-specific access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows admins to manage user profiles, and agents to read their own profile.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, create, update, delete) - Admin can perform all operations.
     * @allow (get) - Agent can read their own profile.
     * @deny (create, update, delete) - Agent cannot create, update, or delete other user profiles.
     * @deny (get, list) - Non-Admin User cannot list all users.
     * @principle Enforces role-based access control and user ownership.
     */
    match /users/{userId} {
      function isAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false; // No user listing allowed.
      allow create: if isAdmin() && request.resource.data.uid == userId;
      allow update: if isAdmin() && resource.data.uid == userId;
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage all customers, and agents to manage only their assigned customers.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get, list, create, update, delete) - Admin can perform all operations.
     * @allow (create) - Agent can create new customer if agent.uid is correct.
     * @allow (get, update, delete) - Agent can manage customers assigned to them (agent.uid matches).
     * @deny (get, list, create, update, delete) - Agent cannot manage customers not assigned to them.
     * @principle Enforces role-based access control and agent-specific customer ownership.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      function isAgent() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
      }
      function isAssignedAgent(agentUid) {
        return request.auth != null && request.auth.uid == agentUid;
      }
      function isExistingAssignedAgent(agentUid) {
        return isAssignedAgent(agentUid) && resource != null;
      }
      allow get, list: if isAdmin();
      allow create: if isAgent() && request.resource.data.agent.uid == request.auth.uid;
      allow update, delete: if isExistingAssignedAgent(resource.data.agent.uid) || isAdmin();
    }
  }
}
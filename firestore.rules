/**
 * @fileoverview Firestore Security Rules for the FINSERV application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for most data, with role-based access for admin users.
 * Data is organized hierarchically under `/users/{userId}`, ensuring clear ownership and facilitating efficient querying.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, including their role ('admin' or 'agent').
 * - /users/{userId}/customers/{customerId}: Stores customer data, including a denormalized `agentId` field.
 * - /users/{userId}/customers/{customerId}/payments/{paymentId}: Stores payment information for customers.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user document (`/users/{userId}`).
 * - Only authenticated users can create user documents, and the `userId` must match their `auth.uid`.
 * - Agents can only manage customers and payments associated with their own user ID (`agentId`).
 * - Listing of all users (`/users`) is forbidden to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * The `agentId` field is denormalized into the `/users/{userId}/customers/{customerId}` documents.
 * This allows the rules to verify ownership of customer data without needing to perform additional `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user creates their own profile.
     * @allow (get, update, delete) Authenticated user accesses their own profile.
     * @deny (list) Prevents listing all users.
     * @deny (create) Unauthenticated user attempts to create a profile.
     * @deny (get, update, delete) User attempts to access another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to customer documents owned by a specific agent.
     * @path /users/{userId}/customers/{customerId}
     * @allow (create) Agent creates a new customer, with agentId matching their own ID.
     * @allow (get, list, update, delete) Agent accesses/modifies their own customers.
     * @deny (create) Agent attempts to create a customer with mismatched agentId.
     * @deny (get, list, update, delete) User attempts to access/modify customers not owned by them.
     * @principle Enforces ownership of customer documents by the assigned agent.
     */
    match /users/{userId}/customers/{customerId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the customer document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an existing owner of the customer document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.agentId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && resource.data.agentId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.agentId == userId;
    }

    /**
     * @description Controls access to payment documents associated with a customer.
     * @path /users/{userId}/customers/{customerId}/payments/{paymentId}
     * @allow (create) Agent creates a payment for their customer.
     * @allow (get, list, update, delete) Agent manages payments for their customers.
     * @deny (create) User attempts to create a payment for a customer they don't manage.
     * @deny (get, list, update, delete) User attempts to access/modify payments for customers not owned by them.
     * @principle Restricts payment management to the agent assigned to the customer.
     */
    match /users/{userId}/customers/{customerId}/payments/{paymentId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the customer document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an existing owner of the customer document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}
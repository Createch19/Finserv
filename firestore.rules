/**
 * @file Firestore Security Rules for FINSERV Application
 * @description This ruleset enforces role-based access control for customer data.
 *
 * Core Philosophy:
 *  - Admins have full access to all customer data.
 *  - Agents can only access and manage customers assigned to them.
 *  - Data validation is relaxed for rapid prototyping but critical relational integrity is enforced.
 *
 * Data Structure:
 *  - Customers are stored in the top-level `/customers` collection.
 *  - Customer documents contain embedded Agent data.
 *
 * Key Security Decisions:
 *  - `customers` collection: Agents can create customer documents, but only for themselves.
 *     They can only update/delete customers assigned to them.  Admins can do anything.
 *  - No listing of all users for security reasons.
 *
 * Denormalization for Authorization:
 *  - The `Customer` document includes the `agent` field with the agent's `uid`, `name`, and `email`. This avoids needing to perform a `get()` operation on a separate `/users` collection to verify the agent's identity and role.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the /customers collection. Admins have full access; agents can only manage their own customers.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (create) - Agent creating a new customer assigned to themselves.
     *    - request.auth.uid: 'agent123'
     *    - request.resource.data.agent.uid: 'agent123'
     * @allow (get, list) - Any authenticated user can read customer information.
     *    - request.auth.uid: 'user456'
     * @allow (update, delete) - Admin updating any customer.
     *    - request.auth.uid: 'admin789'
     * @deny (create) - Agent attempting to create a customer assigned to another agent.
     *    - request.auth.uid: 'agent123'
     *    - request.resource.data.agent.uid: 'agent456'
     * @deny (update, delete) - Agent attempting to update/delete a customer not assigned to them.
     *    - request.auth.uid: 'agent123'
     *    - resource.data.agent.uid: 'agent456'
     * @principle Role-based access control with agent ownership.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.agent.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || isExistingOwner(resource.data.agent.uid));
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin.  This is a placeholder only.
     * @return {boolean} True if the user is an admin, false otherwise.
     * @note This function currently returns false.  Implement proper admin role verification in production.
     */
    function isAdmin() {
      return false;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
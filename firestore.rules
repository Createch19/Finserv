/**
 * @fileoverview Firestore Security Rules for FINSERV application.
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of access for prototyping and UI development,
 * while still enforcing role-based access control for write operations.
 * Specifically, all users can read any data, but only admin and agent roles
 * can create, update, and delete customer data.
 *
 * Data Structure:
 * - `/customers/{customerId}`: Stores customer data. Each customer document
 *   includes an 'agent' field containing agent details (UID, name, email).
 *
 * Key Security Decisions:
 * - All users can read all customer documents.
 * - Only 'admin' and 'agent' users can create, update, and delete customer documents.
 * - The rules do NOT validate the data schema, allowing for flexible data shapes
 *   during prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows admins and agents to create, update, and delete customer data. Read access is public.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get, list): Any user can read customer data.
     * @allow (create, update, delete): Only users with 'admin' or 'agent' roles can modify customer data.
     * @deny All other operations.
     * @principle Role-based access control for write operations, public read access.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'agent');
    }
  }

  // Helper function to check if a user is signed in
  function isSignedIn() {
    return request.auth != null;
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Auth Functions ---
    function isAuthed() {
      return request.auth != null;
    }

    // Get user data directly from the /users collection in Firestore
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      // Prefer the user document in Firestore over token claims.
      return getUserDoc().role;
    }

    function getUserCompanyId() {
      // Prefer the user document in Firestore over token claims.
      return getUserDoc().companyId;
    }
    
    function isSuperAdmin() {
      return getRole() == 'superadmin';
    }

    // --- Resource/Request Context Functions ---
    function isTenantMember(doc) {
      return getUserCompanyId() == doc.companyId;
    }
    
    function isRequestingTenantMember() {
      return getUserCompanyId() == request.resource.data.companyId;
    }

    // --- Collection Rules ---

    match /companies/{companyId} {
      allow create, update, delete: if isSuperAdmin();
      allow read, list: if isAuthed();
    }
    
    match /users/{userId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if getRole() == 'admin' && (isTenantMember(resource.data) || isRequestingTenantMember());
      allow get: if isAuthed() && request.auth.uid == userId;
    }

    match /customers/{customerId} {
      // Super Admin has full access.
      allow read, write: if isSuperAdmin();
      // Admins and agents can manage customers within their own company.
      allow list, read, write: if (getRole() == 'admin' || getRole() == 'agent') && 
                                  (isTenantMember(resource.data) || isRequestingTenantMember());
    }

    match /expenses/{expenseId} {
      // Super Admin has full access.
      allow read, write: if isSuperAdmin();
      // Admins can manage expenses within their own company.
      allow read, write: if getRole() == 'admin' && (isTenantMember(resource.data) || isRequestingTenantMember());
      // For list, we rely on the client query to filter by companyId
      allow list: if isSuperAdmin() || getRole() == 'admin';
    }
    
    match /expenseTypes/{expenseTypeId} {
        allow read, list: if isSuperAdmin() || getRole() == 'admin';
        allow write: if isSuperAdmin() || getRole() == 'admin';
    }
    
    match /withdrawalRequests/{requestId} {
      // Super Admin can read, update, delete, and list all requests.
      allow read, list, update, delete: if isSuperAdmin();
      // Admins can create requests for their own company.
      allow create: if getRole() == 'admin' && isRequestingTenantMember();
      // Admins can read a list of requests, but client query must filter by their companyId.
      allow list: if getRole() == 'admin';
    }

    match /settings/{settingId} {
      // Any authenticated user can read settings (e.g. to apply defaults on client)
      allow read, list: if isAuthed();
      // Only Admins and Super Admins can change settings
      allow write: if isSuperAdmin() || getRole() == 'admin';
    }
  }
}
